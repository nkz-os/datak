# Copy to docker/.env and set your own values before `docker compose up`.
# docker/.env is git-ignored; this example is not, and must never carry a real
# value: a credential committed once stays in the history forever.
#
#   cp docker/.env.example docker/.env
#   # then edit docker/.env
#
# Generate strong values, for example:
#   openssl rand -base64 24

INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=
